rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function userDocument() {
      return get(userPath());
    }

    function sameClub(clubId) {
      return signedIn()
        && exists(userPath())
        && userDocument().data.clubId == clubId;
    }

    function clubPath(clubId) {
      return /databases/$(database)/documents/clubs/$(clubId);
    }

    function clubHasAccess(clubId) {
      let club = get(clubPath(clubId));
      return club.data.maintenanceMode != true
        && (
          club.data.billingEnforcementEnabled != true
          || (
            club.data.accessState == 'enabled'
            && (
              !('graceEndsAt' in club.data)
              || club.data.graceEndsAt == null
              || request.time < club.data.graceEndsAt
            )
            && (
              !('scheduledEndAt' in club.data)
              || club.data.scheduledEndAt == null
              || request.time < club.data.scheduledEndAt
            )
          )
        );
    }

    function isEligibleAccount(clubId) {
      let user = userDocument();
      return signedIn()
        && exists(userPath())
        && user.data.clubId == clubId
        && (
          !('banned' in user.data)
          || user.data.banned != true
        )
        && clubHasAccess(clubId);
    }

    function isActiveUser(clubId) {
      let user = userDocument();
      return signedIn()
        && exists(userPath())
        && user.data.clubId == clubId
        && (
          !('banned' in user.data)
          || user.data.banned != true
        )
        && 'agreedToTerms' in user.data
        && 'termsVersion' in user.data
        && user.data.agreedToTerms == true
        && user.data.termsVersion == '2026-08-28'
        && clubHasAccess(clubId);
    }

    function role(clubId) {
      return isActiveUser(clubId) && userDocument().data.role is int
        ? userDocument().data.role
        : -1;
    }

    function isAdmin(clubId) {
      return role(clubId) >= 1;
    }

    function validAnnouncementReadReceipt(data, clubId, receiptId) {
      return isActiveUser(clubId)
        && data.keys().hasOnly(['userId', 'announcementId', 'readAt'])
        && data.userId == request.auth.uid
        && data.announcementId is string
        && data.announcementId.size() > 0
        && data.announcementId.size() <= 200
        && data.readAt is timestamp
        && receiptId == request.auth.uid + '__' + data.announcementId
        && exists(/databases/$(database)/documents/clubs/$(clubId)/announcements/$(data.announcementId));
    }

    function validEventReadReceipt(data, clubId, receiptId) {
      return isActiveUser(clubId)
        && data.keys().hasOnly(['userId', 'eventId', 'readAt'])
        && data.userId == request.auth.uid
        && data.eventId is string
        && data.eventId.size() > 0
        && data.eventId.size() <= 200
        && data.readAt is timestamp
        && receiptId == request.auth.uid + '__' + data.eventId
        && exists(/databases/$(database)/documents/clubs/$(clubId)/community-events/$(data.eventId));
    }

    function hasPresidentAccess(clubId) {
      return role(clubId) >= 3;
    }

    function contributorPath(clubId, kind, contentId) {
      return /databases/$(database)/documents/clubs/$(clubId)/content-contributors/$(kind + '__' + contentId);
    }

    function settingsPath(clubId) {
      return /databases/$(database)/documents/clubs/$(clubId)/app-settings/public;
    }

    function contributorsAreAnonymous(clubId) {
      return !exists(settingsPath(clubId))
        || get(settingsPath(clubId)).data.sightingsAnonymous != false;
    }

    function canReadContributors(clubId) {
      return isAdmin(clubId) || !contributorsAreAnonymous(clubId);
    }

    function ownsContributor(clubId, kind, contentId) {
      return isActiveUser(clubId)
        && exists(contributorPath(clubId, kind, contentId))
        && get(contributorPath(clubId, kind, contentId)).data.user.id == request.auth.uid;
    }

    function validCurrentUserSnapshot(user, clubId) {
      let currentUser = userDocument();
      return isActiveUser(clubId)
        && user is map
        && user.keys().hasOnly([
          'id',
          'email',
          'role',
          'clubId',
          'platformAdmin'
        ])
        && user.id == request.auth.uid
        && user.email == request.auth.token.email
        && user.role == currentUser.data.role
        && user.clubId == clubId
        && user.platformAdmin == (currentUser.data.platformAdmin == true);
    }

    function validDonationImage(image) {
      return image is map
        && image.keys().hasOnly(['id', 'url'])
        && image.id is string
        && image.id.size() > 0
        && image.id.size() <= 2048
        && image.url is string
        && image.url.size() <= 2048
        && image.url.matches('^https://.+$');
    }

    function validDonationImages(images) {
      return images is list
        && images.size() <= 1
        && (images.size() < 1 || validDonationImage(images[0]));
    }

    function validDonationPage(page) {
      return page is map
        && page.keys().hasOnly([
          'title',
          'description',
          'images',
          'method',
          'externalUrl'
        ])
        && page.title is string
        && page.title.size() <= 120
        && page.description is string
        && page.description.size() <= 5000
        && validDonationImages(page.images)
        && page.method == 'external'
        && page.externalUrl is string
        && page.externalUrl.size() <= 2048
        && (
          (
            page.title.size() == 0
            && page.description.size() == 0
            && page.images.size() == 0
            && page.externalUrl.size() == 0
          )
          || (
            page.title.size() > 0
            && page.description.size() > 0
            && page.externalUrl.matches('^https://.+$')
          )
        );
    }

    function validAppSettings(data) {
      return data.keys().hasOnly([
          'logoUrl',
          'primaryColor',
          'accentColor',
          'sightingsAnonymous',
          'donationPage'
        ])
        && data.logoUrl is string
        && data.logoUrl.size() <= 2048
        && data.primaryColor.matches('^#[0-9A-Fa-f]{6}$')
        && data.accentColor.matches('^#[0-9A-Fa-f]{6}$')
        && data.sightingsAnonymous is bool
        && (
          !('donationPage' in data)
          || validDonationPage(data.donationPage)
        );
    }

    function validCurrentUserContributor(data, clubId, kind, contentId) {
      return data.keys().hasOnly(['kind', 'contentId', 'user'])
        && data.kind == kind
        && data.contentId == contentId
        && validCurrentUserSnapshot(data.user, clubId);
    }

    function hasNewContributor(clubId, kind, contentId) {
      return existsAfter(contributorPath(clubId, kind, contentId))
        && getAfter(contributorPath(clubId, kind, contentId)).data.user.id == request.auth.uid;
    }

    function contentPath(clubId, kind, contentId) {
      return kind == 'sighting'
        ? /databases/$(database)/documents/clubs/$(clubId)/cat-sightings/$(contentId)
        : /databases/$(database)/documents/clubs/$(clubId)/catalog/$(contentId);
    }

    function validWhitelistApplication() {
      return request.resource.data.keys().hasOnly([
          'name',
          'graduationYear',
          'email',
          'codeWord'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 200
        && request.resource.data.graduationYear is string
        && request.resource.data.graduationYear.size() > 0
        && request.resource.data.graduationYear.size() <= 20
        && request.resource.data.email is string
        && request.resource.data.email.size() >= 3
        && request.resource.data.email.size() <= 320
        && request.resource.data.email.matches('^[^@]+@[^@]+\\.[^@]+$')
        && request.resource.data.codeWord is string
        && request.resource.data.codeWord.size() <= 200;
    }

    function validEvent(data, clubId) {
      return data.keys().hasOnly([
          'title',
          'details',
          'location',
          'startsAt',
          'expiresAt',
          'imageUrl',
          'createdAt',
          'createdBy'
        ])
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 120
        && data.title.matches('.*\\S.*')
        && data.details is string
        && data.details.size() > 0
        && data.details.size() <= 5000
        && data.details.matches('.*\\S.*')
        && data.location is string
        && data.location.size() > 0
        && data.location.size() <= 300
        && data.location.matches('.*\\S.*')
        && data.startsAt is timestamp
        && data.expiresAt is timestamp
        && data.expiresAt >= data.startsAt
        && data.imageUrl is string
        && data.imageUrl.size() > 0
        && data.imageUrl.size() <= 2048
        && data.imageUrl.matches('^https://.+$')
        && data.createdAt is timestamp
        && validCurrentUserSnapshot(data.createdBy, clubId);
    }

    function validComment(data, clubId) {
      return data.keys().hasOnly([
          'target',
          'targetKey',
          'body',
          'createdAt',
          'createdById'
        ])
        && data.target is map
        && data.target.keys().hasOnly(['kind', 'id', 'documentId'])
        && (
          data.target.kind == 'sighting'
          || data.target.kind == 'catalog'
          || data.target.kind == 'station'
        )
        && data.target.id is string
        && data.target.id.size() > 0
        && data.target.id.size() <= 200
        && data.target.documentId is string
        && data.target.documentId.size() > 0
        && data.target.documentId.size() <= 200
        && data.targetKey == data.target.kind + ':' + data.target.id
        && data.body is string
        && data.body.size() > 0
        && data.body.size() <= 300
        && data.body.matches('.*\\S.*')
        && data.createdAt is timestamp
        && data.createdById == request.auth.uid
        && commentTargetExists(data.target, clubId);
    }

    function commentTargetExists(target, clubId) {
      return (
          target.kind == 'sighting'
          && (
            (
              target.id == target.documentId
              && exists(/databases/$(database)/documents/clubs/$(clubId)/cat-sightings/$(target.documentId))
            )
            || (
              target.id == 'inat-observation-' + target.documentId
              && exists(/databases/$(database)/documents/clubs/$(clubId)/inaturalist-observations/$(target.documentId))
            )
          )
        )
        || (
          target.kind == 'catalog'
          && (
            (
              target.id == target.documentId
              && exists(/databases/$(database)/documents/clubs/$(clubId)/catalog/$(target.documentId))
            )
            || (
              target.id == 'inat-guide-' + target.documentId
              && exists(/databases/$(database)/documents/clubs/$(clubId)/inaturalist-guide-profiles/$(target.documentId))
            )
          )
        )
        || (
          target.kind == 'station'
          && target.id == target.documentId
          && exists(/databases/$(database)/documents/clubs/$(clubId)/stations/$(target.documentId))
        );
    }

    function commentModerationPath(clubId, commentId) {
      return /databases/$(database)/documents/clubs/$(clubId)/inaturalist-comment-moderation/$(commentId);
    }

    function validImportedCommentModeration(data, clubId, commentId) {
      let comment = get(/databases/$(database)/documents/clubs/$(clubId)/sighting-comments/$(commentId));
      return data.keys().hasOnly([
          'commentId',
          'targetKey',
          'hiddenById',
          'hiddenAt'
        ])
        && comment.data.source == 'inaturalist'
        && data.commentId == commentId
        && data.targetKey == comment.data.targetKey
        && data.hiddenById == request.auth.uid
        && data.hiddenAt is timestamp;
    }

    function activePresidentialElectionPath(clubId) {
      return /databases/$(database)/documents/clubs/$(clubId)/community-vote-state/presidential-election;
    }

    function activeElectionReservationAvailable(clubId) {
      let statePath = activePresidentialElectionPath(clubId);
      return !exists(statePath)
        || get(statePath).data.votingEndsAt <= request.time;
    }

    function validElectionReservation(clubId, voteId, votingEndsAt) {
      let statePath = activePresidentialElectionPath(clubId);
      return activeElectionReservationAvailable(clubId)
        && existsAfter(statePath)
        && getAfter(statePath).data.voteId == voteId
        && getAfter(statePath).data.votingEndsAt == votingEndsAt;
    }

    function validCommunityVote(data, clubId, voteId) {
      return data.keys().hasOnly([
          'kind',
          'title',
          'details',
          'participationAudience',
          'options',
          'createdAt',
          'createdBy',
          'nominationEndsAt',
          'votingStartsAt',
          'votingEndsAt'
        ])
        && data.keys().hasAll([
          'kind',
          'title',
          'details',
          'options',
          'createdAt',
          'createdBy',
          'votingStartsAt',
          'votingEndsAt'
        ])
        && (data.kind == 'contest' || data.kind == 'presidential_election')
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 120
        && data.title.matches('.*\\S.*')
        && data.details is string
        && data.details.size() <= 5000
        && (
          !('participationAudience' in data)
          || data.participationAudience == 'all_members'
          || data.participationAudience == 'officers_only'
        )
        && data.options is list
        && data.options.size() <= 20
        && data.createdAt is timestamp
        && validCurrentUserSnapshot(data.createdBy, clubId)
        && data.votingStartsAt is timestamp
        && data.votingEndsAt is timestamp
        && data.votingEndsAt >= data.votingStartsAt + duration.value(1, 'd')
        && data.votingEndsAt <= data.votingStartsAt + duration.value(14, 'd')
        && (
          (
            data.kind == 'contest'
            && data.createdBy.role >= 1
            && data.options.size() >= 2
            && !('nominationEndsAt' in data)
            && data.votingStartsAt == data.createdAt
          )
          || (
            data.kind == 'presidential_election'
            && hasPresidentAccess(clubId)
            && data.createdBy.role >= 3
            && data.options.size() == 0
            && data.nominationEndsAt is timestamp
            && data.nominationEndsAt == data.votingStartsAt
            && data.votingStartsAt >= data.createdAt + duration.value(1, 'd')
            && data.votingStartsAt <= data.createdAt + duration.value(31, 'd')
            && validElectionReservation(
              clubId,
              voteId,
              data.votingEndsAt
            )
          )
        );
    }

    match /clubs/{clubId} {
      allow get: if isActiveUser(clubId);
      allow list, create, update, delete: if false;

      match /access/{accessId} {
        allow get: if accessId == 'public' && sameClub(clubId);
        allow list, write: if false;
      }

      match /public-profiles/{userId} {
        allow read: if isActiveUser(clubId);
        allow write: if false;
      }

      match /chat-messages/{messageId} {
        allow read: if isActiveUser(clubId);
        allow write: if false;
      }

      match /chat-reactions/{reactionId} {
        allow read: if isActiveUser(clubId);
        allow write: if false;
      }

      match /chat-restrictions/{userId} {
        allow get: if isActiveUser(clubId)
          && (request.auth.uid == userId || isAdmin(clubId));
        allow list: if isAdmin(clubId);
        allow write: if false;
      }

      match /chat-ping-reads/{userId} {
        allow get: if isActiveUser(clubId) && request.auth.uid == userId;
        allow list, write: if false;
      }

      match /cat-sightings/{sightingId} {
        allow read: if isActiveUser(clubId)
          && (canReadContributors(clubId) || !('createdBy' in resource.data));
        allow create: if isActiveUser(clubId)
          && !('createdBy' in request.resource.data)
          && hasNewContributor(clubId, 'sighting', sightingId);
        allow update: if ownsContributor(clubId, 'sighting', sightingId)
          && !('createdBy' in request.resource.data);
        allow delete: if ownsContributor(clubId, 'sighting', sightingId)
          && !existsAfter(contributorPath(clubId, 'sighting', sightingId));
      }

      match /catalog/{entryId} {
        allow read: if isActiveUser(clubId)
          && (canReadContributors(clubId) || !('createdBy' in resource.data));
        allow create, update: if isAdmin(clubId)
          && !('createdBy' in request.resource.data)
          && hasNewContributor(clubId, 'catalog', entryId);
        allow delete: if isAdmin(clubId)
          && !existsAfter(contributorPath(clubId, 'catalog', entryId));
      }

      match /content-contributors/{contributorId} {
        allow read: if isActiveUser(clubId)
          && (canReadContributors(clubId) || resource.data.user.id == request.auth.uid);
        allow create: if (
            validCurrentUserContributor(
              request.resource.data,
              clubId,
              request.resource.data.kind,
              request.resource.data.contentId
            )
            && (
              request.resource.data.kind == 'sighting'
              || (request.resource.data.kind == 'catalog' && isAdmin(clubId))
            )
            && contributorId == request.resource.data.kind + '__' + request.resource.data.contentId
            && existsAfter(contentPath(
              clubId,
              request.resource.data.kind,
              request.resource.data.contentId
            ))
          );
        allow update: if validCurrentUserContributor(
            request.resource.data,
            clubId,
            resource.data.kind,
            resource.data.contentId
          )
          && contributorId == resource.data.kind + '__' + resource.data.contentId
          && (
            (resource.data.kind == 'sighting' && resource.data.user.id == request.auth.uid)
            || (resource.data.kind == 'catalog' && isAdmin(clubId))
          );
        allow delete: if (
            (resource.data.kind == 'sighting' && resource.data.user.id == request.auth.uid)
            || (resource.data.kind == 'catalog' && isAdmin(clubId))
          )
          && !existsAfter(contentPath(clubId, resource.data.kind, resource.data.contentId));
      }

      match /app-settings/{settingsId} {
        allow read: if settingsId == 'public'
          && (!signedIn() || isActiveUser(clubId));
        allow create: if settingsId == 'public'
          && validAppSettings(request.resource.data)
          && hasPresidentAccess(clubId);
        allow update: if settingsId == 'public'
          && validAppSettings(request.resource.data)
          && hasPresidentAccess(clubId);
        allow delete: if false;
      }

      match /catalog-favorites/{userId} {
        allow read: if isActiveUser(clubId);
        allow create, update: if isActiveUser(clubId)
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['catalogId', 'createdAt'])
          && request.resource.data.catalogId is string
          && request.resource.data.catalogId.size() > 0
          && request.resource.data.catalogId.size() <= 200
          && request.resource.data.createdAt is timestamp;
        allow delete: if isActiveUser(clubId) && request.auth.uid == userId;
      }

      match /sighting-comments/{commentId} {
        allow read: if isActiveUser(clubId);
        allow create: if isActiveUser(clubId)
          && validComment(request.resource.data, clubId)
          && request.resource.data.target.kind == 'sighting';
        allow update: if false;
        allow delete: if isAdmin(clubId)
          && (
            !('source' in resource.data)
            || resource.data.source != 'inaturalist'
            || (
              existsAfter(commentModerationPath(clubId, commentId))
              && getAfter(commentModerationPath(clubId, commentId)).data.commentId == commentId
            )
          );
      }

      match /inaturalist-comment-moderation/{commentId} {
        allow read: if isAdmin(clubId);
        allow create: if isAdmin(clubId)
          && validImportedCommentModeration(
            request.resource.data,
            clubId,
            commentId
          );
        allow update, delete: if false;
      }

      match /catalog-comments/{commentId} {
        allow read: if isActiveUser(clubId);
        allow create: if isActiveUser(clubId)
          && validComment(request.resource.data, clubId)
          && request.resource.data.target.kind == 'catalog';
        allow update: if false;
        allow delete: if isAdmin(clubId);
      }

      match /station-comments/{commentId} {
        allow read: if isAdmin(clubId);
        allow create: if isAdmin(clubId)
          && validComment(request.resource.data, clubId)
          && request.resource.data.target.kind == 'station';
        allow update: if false;
        allow delete: if isAdmin(clubId);
      }

      match /catalog-tag-settings/{settingsId} {
        allow read: if settingsId == 'catalog' && isActiveUser(clubId);
        allow create, update: if settingsId == 'catalog'
          && isAdmin(clubId)
          && request.resource.data.keys().hasOnly(['tags'])
          && request.resource.data.tags is list
          && request.resource.data.tags.size() <= 50;
        allow delete: if false;
      }

      match /catalog-tag-assignments/{catalogId} {
        allow read: if isActiveUser(clubId);
        allow create, update: if isAdmin(clubId)
          && request.resource.data.keys().hasOnly(['tagIds'])
          && request.resource.data.tagIds is list
          && request.resource.data.tagIds.size() <= 50;
        allow delete: if isAdmin(clubId);
      }

      match /stations/{stationId} {
        allow read: if isActiveUser(clubId);
        allow create, update, delete: if isAdmin(clubId);
      }

      match /announcements/{announcementId} {
        allow read: if isActiveUser(clubId);
        allow create, update, delete: if isAdmin(clubId);
      }

      match /announcement-read-receipts/{receiptId} {
        allow get, list: if isActiveUser(clubId)
          && resource.data.userId == request.auth.uid;
        allow create, update: if validAnnouncementReadReceipt(
          request.resource.data,
          clubId,
          receiptId
        );
        allow delete: if false;
      }

      match /community-events/{eventId} {
        allow read: if isActiveUser(clubId);
        allow create: if isAdmin(clubId)
          && validEvent(request.resource.data, clubId);
        allow update: if isAdmin(clubId)
          && validEvent(request.resource.data, clubId)
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.createdBy == resource.data.createdBy;
        allow delete: if isAdmin(clubId);
      }

      match /event-read-receipts/{receiptId} {
        allow get, list: if isActiveUser(clubId)
          && resource.data.userId == request.auth.uid;
        allow create, update: if validEventReadReceipt(
          request.resource.data,
          clubId,
          receiptId
        );
        allow delete: if false;
      }

      match /community-surveys/{surveyId} {
        allow read: if isActiveUser(clubId);
        allow create: if isAdmin(clubId)
          && request.resource.data.keys().hasOnly([
            'title',
            'details',
            'anonymous',
            'participationAudience',
            'status',
            'questions',
            'createdAt',
            'createdBy'
          ])
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 120
          && request.resource.data.title.matches('.*\\S.*')
          && request.resource.data.details is string
          && request.resource.data.details.size() <= 5000
          && request.resource.data.anonymous is bool
          && (
            !('participationAudience' in request.resource.data)
            || request.resource.data.participationAudience == 'all_members'
            || request.resource.data.participationAudience == 'officers_only'
          )
          && request.resource.data.status == 'open'
          && request.resource.data.questions is list
          && request.resource.data.questions.size() > 0
          && request.resource.data.questions.size() <= 40
          && request.resource.data.createdAt is timestamp
          && validCurrentUserSnapshot(request.resource.data.createdBy, clubId);
        allow update: if isAdmin(clubId)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'closedAt'])
          && resource.data.status == 'open'
          && request.resource.data.status == 'closed'
          && request.resource.data.closedAt is timestamp;
        allow delete: if false;
      }

      match /survey-responses/{responseId} {
        allow read: if isAdmin(clubId);
        allow write: if false;
      }

      match /survey-submission-receipts/{receiptId} {
        allow get: if isActiveUser(clubId)
          && receiptId.matches('^' + request.auth.uid + '__.+$');
        allow list, create, update, delete: if false;
      }

      match /community-votes/{voteId} {
        allow read: if isActiveUser(clubId);
        allow create: if validCommunityVote(request.resource.data, clubId, voteId);
        allow update, delete: if false;
      }

      match /community-vote-state/{stateId} {
        allow read: if isActiveUser(clubId);
        allow create, update: if stateId == 'presidential-election'
          && hasPresidentAccess(clubId)
          && activeElectionReservationAvailable(clubId)
          && request.resource.data.keys().hasOnly([
            'voteId',
            'votingEndsAt'
          ])
          && request.resource.data.voteId is string
          && request.resource.data.voteId.size() > 0
          && request.resource.data.voteId.size() <= 200
          && request.resource.data.votingEndsAt is timestamp
          && existsAfter(
            /databases/$(database)/documents/clubs/$(clubId)/community-votes/$(request.resource.data.voteId)
          )
          && getAfter(
            /databases/$(database)/documents/clubs/$(clubId)/community-votes/$(request.resource.data.voteId)
          ).data.kind == 'presidential_election'
          && getAfter(
            /databases/$(database)/documents/clubs/$(clubId)/community-votes/$(request.resource.data.voteId)
          ).data.votingEndsAt == request.resource.data.votingEndsAt;
        allow delete: if false;
      }

      match /community-vote-nominees/{nomineeId} {
        allow read: if isActiveUser(clubId);
        allow write: if false;
      }

      match /community-vote-nomination-receipts/{receiptId} {
        allow get: if isActiveUser(clubId)
          && receiptId.matches('^' + request.auth.uid + '__.+$');
        allow list, create, update, delete: if false;
      }

      match /community-vote-ballots/{ballotId} {
        allow read, write: if false;
      }

      match /community-vote-ballot-receipts/{receiptId} {
        allow get: if isActiveUser(clubId)
          && receiptId.matches('^' + request.auth.uid + '__.+$');
        allow list, create, update, delete: if false;
      }

      match /contact-info/{contactId} {
        allow read: if isActiveUser(clubId);
        allow create, update, delete: if isAdmin(clubId);
      }

      match /inaturalist-observations/{observationId} {
        allow read: if isActiveUser(clubId)
          && (resource.data.visible == true || isAdmin(clubId));
        allow write: if false;
      }

      match /inaturalist-guide-profiles/{profileId} {
        allow read: if isActiveUser(clubId)
          && (resource.data.visible == true || isAdmin(clubId));
        allow write: if false;
      }

      match /inaturalist-public-links/{inaturalistUserId} {
        allow read: if isActiveUser(clubId);
        allow write: if false;
      }

      match /integration-state/{integrationId} {
        allow read: if isAdmin(clubId);
        allow write: if false;
      }

      match /whitelist/{applicationId} {
        allow create: if validWhitelistApplication();
        allow read, delete: if isAdmin(clubId);
        allow update: if false;
      }

      match /billing-usage/{periodId} {
        allow read, write: if false;
      }
    }

    match /users/{userId} {
      allow get: if signedIn()
        && (
          request.auth.uid == userId
          || (
            isActiveUser(resource.data.clubId)
            && isAdmin(resource.data.clubId)
            && userDocument().data.clubId == resource.data.clubId
          )
        );
      allow list: if signedIn()
        && isActiveUser(resource.data.clubId)
        && isAdmin(resource.data.clubId)
        && userDocument().data.clubId == resource.data.clubId;
      allow create: if false;
      allow update: if signedIn()
        && request.auth.uid == userId
        && isEligibleAccount(resource.data.clubId)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'expoPushToken',
            'agreedToTerms',
            'termsVersion',
            'termsAgreedAt'
          ])
        && (
          !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['agreedToTerms', 'termsVersion', 'termsAgreedAt'])
          || (
            request.resource.data.agreedToTerms == true
            && request.resource.data.termsVersion == '2026-08-28'
            && request.resource.data.termsAgreedAt == request.time
          )
          || (
            !('agreedToTerms' in resource.data)
            && !('termsVersion' in resource.data)
            && request.resource.data.agreedToTerms == false
            && request.resource.data.termsVersion == ''
            && !('termsAgreedAt' in request.resource.data)
          )
        );
      allow delete: if false;
    }

    match /platform-admins/{userId} {
      allow get: if signedIn() && request.auth.uid == userId;
      allow list, write: if false;
    }

    // University discovery is exposed only through bounded callable projections.
    // Clients must never read provider metadata, claims, tokens, or rate-limit state.
    match /universities/{universityId} {
      allow read, write: if false;
    }

    match /university-overrides/{universityId} {
      allow read, write: if false;
    }

    match /university-clubs/{universityId} {
      allow read, write: if false;
    }

    match /university-club-claims/{universityId} {
      allow read, write: if false;
    }

    match /club-onboarding-requests/{requestId} {
      allow read, write: if false;
    }

    match /club-onboarding-rate-limits/{limitId} {
      allow read, write: if false;
    }

    match /billing-accounts/{clubId} {
      allow read, write: if false;
    }

    match /billing-usage-events/{eventId} {
      allow read, write: if false;
    }

    match /stripe-events/{eventId} {
      allow read, write: if false;
    }

    match /billing-invoice-reconciliations/{invoiceId} {
      allow read, write: if false;
    }

    match /inaturalist-link-attempts/{attemptId} {
      allow read, write: if false;
    }

    match /inaturalist-account-links/{userId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
