# Copy to .env.supabase.local (ignored). These values are SERVER ONLY.
# Do not use EXPO_PUBLIC_ prefixes or paste credentials into chat.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
# Connect > Session pooler > PostgreSQL URI. Keep sslmode=require.
# URL-encode special characters in the database password.
SUPABASE_DB_URL=postgresql://postgres.YOUR_PROJECT_REF:ENCODED_PASSWORD@YOUR_SESSION_POOLER_HOST:5432/postgres?sslmode=require
SUPABASE_FIREBASE_PROJECT_ID=campuscats-d7a5e
