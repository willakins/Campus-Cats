{
  "expo": {
    "name": "Campus Cats",
    "slug": "campus-cats",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/images/default-app-icon.png",
    "scheme": "campuscats",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gatech.CampusCats",
      "config": {
        "googleMapsApiKey": "AIzaSyD2koOi8GGUrbCZVju5Dq8Ca_1hxHb1mb8"
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Campus Cats uses your location to help volunteers find nearby feeding stations and cat sightings.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "aps-environment": "development"
      },
      "buildNumber": "1"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/default-app-icon.png",
        "backgroundColor": "#ffffff"
      },
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyD2koOi8GGUrbCZVju5Dq8Ca_1hxHb1mb8"
        }
      },
      "permissions": [
        "android.permission.CAMERA"
      ],
      "package": "com.gatech.CampusCats"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/default-app-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/default-app-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to select cat photos.",
          "cameraPermission": "Allow $(PRODUCT_NAME) to take cat photos.",
          "microphonePermission": false
        }
      ],
      "expo-font",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "1568853b-6f93-4d20-98f9-9425f3648b76"
      }
    },
    "owner": "willakins",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/1568853b-6f93-4d20-98f9-9425f3648b76"
    }
  }
}
