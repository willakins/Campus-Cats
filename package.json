{
  "name": "campuscats",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest --watch",
    "test:ci": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage && node scripts/check-coverage.js",
    "test:emulator": "jest --config jest.emulator.config.js --runInBand",
    "emulator:exec": "firebase emulators:exec --project demo-campus-cats-test --only firestore,storage \"npm run test:emulator\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx --max-warnings=0",
    "format:check": "prettier --check \"docs/**/*.md\"",
    "ui:check": "node scripts/check-ui-colors.js",
    "platform:check": "node scripts/check-platform-compat.js",
    "hosting:check": "node scripts/check-hosting.js",
    "hosting:env": "node scripts/check-hosting-environment.js",
    "hosting:build": "npm run hosting:env && expo export --platform web && npm run hosting:check",
    "hosting:serve": "npm run hosting:build && firebase emulators:start --only hosting --project demo-campus-cats-test",
    "quality": "npm run typecheck && npm run lint && npm run format:check && npm run ui:check && npm run platform:check && npm run hosting:check"
  },
  "dependencies": {
    "@expo/vector-icons": "^14.0.4",
    "@hookform/resolvers": "^4.1.3",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-native-community/datetimepicker": "8.2.0",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/native": "^7.0.14",
    "@teovilla/react-native-web-maps": "^0.9.5",
    "expo": "~52.0.42",
    "expo-dev-client": "~5.0.16",
    "expo-device": "~7.0.3",
    "expo-image-picker": "~16.0.6",
    "expo-linking": "~7.0.5",
    "expo-location": "~18.0.9",
    "expo-notifications": "~0.29.14",
    "expo-router": "~4.0.19",
    "expo-splash-screen": "~0.29.22",
    "expo-status-bar": "~2.0.1",
    "expo-system-ui": "~4.0.9",
    "expo-updates": "~0.27.4",
    "expo-web-browser": "~14.0.2",
    "firebase": "^11.6.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.55.0",
    "react-native": "0.76.8",
    "react-native-dropdown-picker": "^5.4.6",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-get-random-values": "^1.11.0",
    "react-native-maps": "1.18.0",
    "react-native-paper": "^5.13.1",
    "react-native-reanimated": "~3.16.1",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-web": "~0.19.13",
    "uuid": "^11.0.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@babel/core": "^7.26.7",
    "@firebase/rules-unit-testing": "^4.0.1",
    "@testing-library/react-native": "^12.9.0",
    "@types/babel__core": "^7.20.5",
    "@types/babel__traverse": "^7.20.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.14.0",
    "@types/react": "^18.2.0",
    "@types/react-test-renderer": "^18.2.0",
    "eslint": "^8.57.1",
    "eslint-config-expo": "~8.0.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "firebase-tools": "^14.1.0",
    "globals": "^16.0.0",
    "jest": "~29.7.0",
    "jest-expo": "~52.0.6",
    "prettier": "^3.9.6",
    "react-test-renderer": "18.2.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.29.0"
  },
  "private": true
}
