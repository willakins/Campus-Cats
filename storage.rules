rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function role() {
      return signedIn()
        ? firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role
        : -1;
    }

    function isAdmin() {
      return role() >= 1;
    }

    function ownsSighting(sightingId) {
      return signedIn()
        && (
          resource.metadata.ownerId == request.auth.uid
          || (
            firestore.exists(/databases/(default)/documents/cat-sightings/$(sightingId))
            && firestore.get(/databases/(default)/documents/cat-sightings/$(sightingId)).data.createdBy.id == request.auth.uid
          )
        );
    }

    match /cat-sightings/{sightingId}/{fileName} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.metadata.ownerId == request.auth.uid;
      allow update, delete: if ownsSighting(sightingId);
    }

    match /catalog/{entryId}/{fileName} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /stations/{stationId}/{fileName} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /announcements/{announcementId}/{fileName} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
