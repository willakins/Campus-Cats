rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function userDocument() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid));
    }

    function sameClub(clubId) {
      return signedIn()
        && sessionIsCurrent(userDocument().data)
        && userDocument().data.clubId == clubId;
    }

    function sessionIsCurrent(user) {
      return (!('deletionPending' in user) || user.deletionPending != true)
        && (!('sessionRevokedAt' in user)
        || (user.sessionRevokedAt is int
          && request.auth.token.auth_time is int
          && request.auth.token.auth_time > user.sessionRevokedAt));
    }

    function clubDocument(clubId) {
      return firestore.get(/databases/(default)/documents/clubs/$(clubId));
    }

    function clubHasAccess(clubId) {
      let club = clubDocument(clubId);
      return club.data.maintenanceMode != true
        && (
          club.data.billingEnforcementEnabled != true
          || (
            club.data.accessState == 'enabled'
            && (
              !('graceEndsAt' in club.data)
              || club.data.graceEndsAt == null
              || request.time < club.data.graceEndsAt
            )
            && (
              !('scheduledEndAt' in club.data)
              || club.data.scheduledEndAt == null
              || request.time < club.data.scheduledEndAt
            )
          )
        );
    }

    function isActiveUser(clubId) {
      return sameClub(clubId)
        && (
          !('banned' in userDocument().data)
          || userDocument().data.banned != true
        )
        && 'agreedToTerms' in userDocument().data
        && 'termsVersion' in userDocument().data
        && userDocument().data.agreedToTerms == true
        && userDocument().data.termsVersion == '2026-08-28'
        && clubHasAccess(clubId);
    }

    function role(clubId) {
      return isActiveUser(clubId) ? userDocument().data.role : -1;
    }

    function isAdmin(clubId) {
      return role(clubId) >= 1;
    }

    function hasPresidentAccess(clubId) {
      return role(clubId) >= 3;
    }

    function validImage() {
      return request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|gif|avif|heic|heif)')
        && !('billingInitiatedBy' in request.resource.metadata);
    }

    function hasSighting(clubId, sightingId) {
      return firestore.exists(/databases/(default)/documents/clubs/$(clubId)/cat-sightings/$(sightingId));
    }

    function ownsSightingRecord(clubId, sightingId) {
      return firestore.get(/databases/(default)/documents/clubs/$(clubId)/content-contributors/$(('sighting__' + sightingId))).data.user.id == request.auth.uid;
    }

    function ownsSighting(clubId, sightingId) {
      return isActiveUser(clubId) && (
        hasSighting(clubId, sightingId)
          ? ownsSightingRecord(clubId, sightingId)
          : resource.metadata.ownerId == request.auth.uid
      );
    }

    match /clubs/{clubId}/cat-sightings/{sightingId}/{fileName} {
      allow read: if isActiveUser(clubId);
      allow create: if isActiveUser(clubId)
        && (!hasSighting(clubId, sightingId) || ownsSightingRecord(clubId, sightingId))
        && validImage()
        && request.resource.metadata.ownerId == request.auth.uid;
      allow update: if ownsSighting(clubId, sightingId)
        && validImage()
        && request.resource.metadata.ownerId == request.auth.uid;
      allow delete: if ownsSighting(clubId, sightingId);
    }

    match /clubs/{clubId}/public-profiles/{userId}/{fileName} {
      allow read: if isActiveUser(clubId);
      allow create: if isActiveUser(clubId)
        && request.auth.uid == userId
        && validImage()
        && request.resource.metadata.ownerId == request.auth.uid;
      allow update: if isActiveUser(clubId)
        && request.auth.uid == userId
        && resource.metadata.ownerId == request.auth.uid
        && validImage()
        && request.resource.metadata.ownerId == request.auth.uid;
      allow delete: if isActiveUser(clubId)
        && request.auth.uid == userId
        && resource.metadata.ownerId == request.auth.uid;
    }

    match /clubs/{clubId}/catalog/{entryId}/{fileName} {
      allow read: if isActiveUser(clubId);
      allow create, update: if isAdmin(clubId) && validImage();
      allow delete: if isAdmin(clubId);
    }

    match /clubs/{clubId}/stations/{stationId}/{fileName} {
      allow read: if isActiveUser(clubId);
      allow create, update: if isAdmin(clubId) && validImage();
      allow delete: if isAdmin(clubId);
    }

    match /clubs/{clubId}/alerts/{alertId}/{fileName} {
      allow read: if isActiveUser(clubId);
      allow create, update: if isAdmin(clubId) && validImage();
      allow delete: if isAdmin(clubId);
    }

    match /clubs/{clubId}/community-events/{eventId}/{fileName} {
      allow read: if isActiveUser(clubId);
      allow create, update: if isAdmin(clubId) && validImage();
      allow delete: if isAdmin(clubId);
    }

    match /clubs/{clubId}/community-votes/{voteId}/{fileName} {
      allow read: if isActiveUser(clubId);
      allow create, update: if isAdmin(clubId) && validImage();
      allow delete: if isAdmin(clubId);
    }

    match /clubs/{clubId}/app-branding/{fileName} {
      allow read: if !signedIn() || isActiveUser(clubId);
      allow create, update: if hasPresidentAccess(clubId) && validImage();
      allow delete: if hasPresidentAccess(clubId);
    }

    match /clubs/{clubId}/donations/{fileName} {
      allow read: if isActiveUser(clubId);
      allow create, update: if hasPresidentAccess(clubId) && validImage();
      allow delete: if hasPresidentAccess(clubId);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
