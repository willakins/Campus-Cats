rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isActiveUser() {
      return signedIn()
        && (!('banned' in firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data)
          || firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.banned != true);
    }

    function role() {
      return isActiveUser()
        ? firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role
        : -1;
    }

    function isAdmin() {
      return role() >= 1;
    }

    function isPresident() {
      return role() == 3;
    }

    function ownsSighting(sightingId) {
      return isActiveUser()
        && (
          resource.metadata.ownerId == request.auth.uid
          || (
            firestore.exists(/databases/(default)/documents/cat-sightings/$(sightingId))
            && firestore.exists(/databases/(default)/documents/content-contributors/$(('sighting__' + sightingId)))
            && firestore.get(/databases/(default)/documents/content-contributors/$(('sighting__' + sightingId))).data.user.id == request.auth.uid
          )
        );
    }

    match /cat-sightings/{sightingId}/{fileName} {
      allow read: if isActiveUser();
      allow create: if isActiveUser()
        && request.resource.metadata.ownerId == request.auth.uid;
      allow update, delete: if ownsSighting(sightingId);
    }

    match /public-profiles/{userId}/{fileName} {
      allow read: if isActiveUser();
      allow create: if isActiveUser()
        && request.auth.uid == userId
        && request.resource.metadata.ownerId == request.auth.uid
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow update, delete: if isActiveUser()
        && request.auth.uid == userId
        && resource.metadata.ownerId == request.auth.uid
        && (request.resource == null
          || (request.resource.size <= 10 * 1024 * 1024
            && request.resource.metadata.ownerId == request.auth.uid
            && request.resource.contentType.matches('image/.*')));
    }

    match /catalog/{entryId}/{fileName} {
      allow read: if isActiveUser();
      allow write: if isAdmin();
    }

    match /stations/{stationId}/{fileName} {
      allow read: if isActiveUser();
      allow write: if isAdmin();
    }

    match /announcements/{announcementId}/{fileName} {
      allow read: if isActiveUser();
      allow write: if isAdmin();
    }

    match /community-events/{eventId}/{fileName} {
      allow read: if isActiveUser();
      allow create, update: if isAdmin()
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isAdmin();
    }

    match /app-branding/{fileName} {
      allow read: if true;
      allow create, update: if isPresident()
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isPresident();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
