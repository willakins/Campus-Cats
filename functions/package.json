{
  "name": "functions",
  "scripts": {
    "build": "tsc",
    "test": "node --test lib/**/*.test.js",
    "test:ci": "npm run build && npm test",
    "contract:inaturalist:live": "npm run build && node lib/inaturalistContract.js",
    "admin:create-club": "npm run build && node lib/admin/createClub.js",
    "admin:migrate-campus-cats": "npm run build && node lib/admin/migrateCampusCatsTenant.js",
    "admin:rollback-campus-cats": "npm run build && node lib/admin/rollbackCampusCatsTenant.js",
    "admin:sync-universities": "npm run build && node lib/admin/syncUniversityCatalog.js",
    "admin:seed-georgia-tech-university": "npm run build && node lib/admin/seedGeorgiaTechUniversity.js",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@google-cloud/bigquery": "^9.0.1",
    "@sendgrid/mail": "^8.1.6",
    "firebase-admin": "^14.2.0",
    "firebase-functions": "^7.3.2",
    "stripe": "^22.4.0",
    "tldts": "^7.4.10",
    "tz-lookup": "^6.1.25"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/tz-lookup": "^6.1.2",
    "firebase-tools": "^15.25.1",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3"
  },
  "private": true
}
